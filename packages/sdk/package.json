{
  "name": "@pivoturl/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for PivotUrl link management platform",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["PivotUrl", "url-shortener", "link-management", "analytics", "sdk"],
  "engines": { "node": ">=18" },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
