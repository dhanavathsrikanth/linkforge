{
  "name": "pivoturl-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the PivotUrl API — link shorting, analytics, and QR codes.",
  "license": "MIT",
  "author": "PivotUrl",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "PivotUrl",
    "link-shortener",
    "analytics",
    "qr-code",
    "sdk"
  ]
}
